<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:padding="8dp"
    android:layout_margin="8dp"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:id="@+id/profilePic"
        android:src="@drawable/account_cowboy_hat"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/name"
        android:text="name goes here"
        android:textSize="24dp"
        android:textColor="@color/black"
        app:layout_constraintEnd_toStartOf="@id/songImage"
        app:layout_constraintStart_toEndOf="@id/profilePic"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/email"
        android:text="email goes here"
        android:textSize="16dp"
        app:layout_constraintStart_toEndOf="@id/profilePic"
        app:layout_constraintTop_toBottomOf="@id/name"
        app:layout_constraintEnd_toStartOf="@id/songImage"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/songLabel"
        android:textSize="12dp"
        android:text="Aux: "
        app:layout_constraintStart_toEndOf="@id/profilePic"
        app:layout_constraintTop_toBottomOf="@id/email"
        />
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/songName"
        android:textSize="12dp"
        android:text="song goes here"
        app:layout_constraintStart_toEndOf="@id/songLabel"
        app:layout_constraintTop_toTopOf="@id/songLabel"
        app:layout_constraintEnd_toStartOf="@id/songImage"/>
    <ImageView
        android:id="@+id/songImage"
        android:layout_width="75dp"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:scaleType="fitCenter"
        />








</androidx.constraintlayout.widget.ConstraintLayout>