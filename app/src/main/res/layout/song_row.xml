<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp"
        android:layout_margin="8dp"
        android:orientation="horizontal">
    <!-- Background attribute gives the whole layout the satisfying ripple
    effect on selection -->

    <!-- XXX Write the row layout, textSize 20sp -->
    <ImageView
        android:id="@+id/rowImageView"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/rowArtist"
        android:scaleType="fitCenter"
        />
    <TextView
        android:id="@+id/rowName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Title"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:padding="2dp"
        app:layout_constraintStart_toEndOf="@id/rowImageView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rowTime"
        />
    <TextView
        android:padding="2dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/rowArtist"
        android:text="Artist"
        android:textSize="16sp"
        android:textColor="@color/grey"
        app:layout_constraintTop_toBottomOf="@id/rowName"
        app:layout_constraintStart_toEndOf="@id/rowImageView"
        app:layout_constraintEnd_toStartOf="@id/rowListensLabel"/>
    <TextView
        android:id="@+id/rowTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:textSize="20sp"
        android:text="0:00"
        app:layout_constraintStart_toEndOf="@id/rowName"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:id="@+id/rowListensLabel"
        android:scaleType="fitCenter"
        android:src="@drawable/headphones"
        app:layout_constraintTop_toTopOf="@id/rowArtist"
        app:layout_constraintBottom_toBottomOf="@id/rowArtist"
        app:layout_constraintEnd_toStartOf="@+id/rowListensColon"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/rowListensColon"
        android:text=":"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/rowListensLabel"
        app:layout_constraintTop_toTopOf="@id/rowListensLabel"
        app:layout_constraintBottom_toBottomOf="@id/rowListensLabel"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/rowListens"
        android:text="0"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/rowListensColon"
        app:layout_constraintTop_toTopOf="@id/rowListensLabel"
        app:layout_constraintBottom_toBottomOf="@id/rowListensColon"/>


</androidx.constraintlayout.widget.ConstraintLayout>
