<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

<!--Bio, name, and profile pic-->
        <ImageView
            android:layout_margin="8dp"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:id="@+id/profilePic"
            android:src="@drawable/account_cowboy_hat"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:layout_margin="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="name goes here"
            android:id="@+id/name"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/profilePic"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:layout_margin="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:hint="Press and hold to edit bio"
            android:id="@+id/bio"
            android:textColor="@color/grey"
            android:textSize="16sp"
            android:maxLines="4"
            android:minLines="4"
            app:layout_constraintTop_toBottomOf="@id/name"
            app:layout_constraintStart_toEndOf="@id/profilePic"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/topSeparator"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/grey"
            android:layout_margin="8dp"
            app:layout_constraintTop_toBottomOf="@id/bio"
            />

<!--Last Played Song-->
        <TextView
            android:id="@+id/lastSongLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What's on Aux? "
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/topSeparator"
            app:layout_constraintStart_toStartOf="parent"/>
        <include
            android:id="@+id/lastSong"
            layout="@layout/song_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/lastSongLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


<!--Top Spotify Songs-->
        <ImageView
            android:id="@+id/spotifySeparator"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/grey"
            android:layout_margin="8dp"
            app:layout_constraintTop_toBottomOf="@id/lastSong"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/SpotifyTopSongsLabel"
            android:text="Spotify Jams"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@+id/spotifySeparator"
            app:layout_constraintStart_toStartOf="parent"/>
        <include
            android:id="@+id/topSpotifySong1"
            layout="@layout/song_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/SpotifyTopSongsLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <include
            android:id="@+id/topSpotifySong2"
            layout="@layout/song_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/topSpotifySong1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <include
            android:id="@+id/topSpotifySong3"
            layout="@layout/song_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/topSpotifySong2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

<!--Top Local Songs-->

        <ImageView
            android:id="@+id/localSeparator"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/grey"
            android:layout_margin="8dp"
            app:layout_constraintTop_toBottomOf="@id/topSpotifySong3"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/LocalTopSongsLabel"
            android:text="Local Jams"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@+id/localSeparator"
            app:layout_constraintStart_toStartOf="parent"/>
        <include
            android:id="@+id/topLocalSong1"
            layout="@layout/song_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/LocalTopSongsLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <include
            android:id="@+id/topLocalSong2"
            layout="@layout/song_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/topLocalSong1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <include
            android:id="@+id/topLocalSong3"
            layout="@layout/song_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/topLocalSong2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


<!--Spotify Authentication button (if not authenticated already)-->
    <Button
            android:id="@+id/spotifyAuthButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect to Spotify"
            app:layout_constraintTop_toBottomOf="@id/SpotifyTopSongsLabel"
            app:layout_constraintBottom_toTopOf="@id/localSeparator"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>












